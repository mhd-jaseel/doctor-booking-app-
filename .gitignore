# =============================================================================
# Doctor Booking App — Root .gitignore
# Covers: Node.js, React Native (Expo), MongoDB, IDE, OS, and build artifacts
# =============================================================================

# ---------------------------------------------------------------------------
# Dependencies — never commit node_modules
# ---------------------------------------------------------------------------
node_modules/
**/node_modules/

# ---------------------------------------------------------------------------
# Environment & Secrets — NEVER commit actual secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.production
.env.staging
**/.env
**/.env.local
**/.env.production

# Signing / Keystore files (Android release signing keys)
*.keystore
*.jks
*.p12
*.pem

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Build outputs — generated files, not source
# ---------------------------------------------------------------------------
dist/
build/
out/
.output/

# Android build outputs (generated by Gradle/EAS — not source)
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties

# APK / AAB release bundles (large binary artifacts)
*.apk
*.aab

# ---------------------------------------------------------------------------
# React Native / Expo specific
# ---------------------------------------------------------------------------
# Expo local cache and device-specific settings
.expo/
.expo-shared/

# Metro bundler cache
.metro-cache/

# Expo web build output (generated, reproducible via `npx expo export:web`)
mobile/dist/

# Expo temp web build inside metro
web-build/

# Errant OS-level folder accidentally created inside project
mobile/%ProgramData%/

# ---------------------------------------------------------------------------
# IDE / Editor files
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.iml
.fleet/

# JetBrains
*.iml
.idea/

# ---------------------------------------------------------------------------
# OS Generated files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Testing / Coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# ---------------------------------------------------------------------------
# Temporary / misc
# ---------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
.cache/
.parcel-cache/
.turbo/

# ---------------------------------------------------------------------------
# Package manager lock file notes
# package-lock.json / yarn.lock ARE committed (reproducible installs)
# ---------------------------------------------------------------------------
